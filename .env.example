# Copy to .env for local runs (never commit .env)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Models (no model names in code). Newer Gemini models may need GOOGLE_CLOUD_LOCATION=global.
# GEMINI_MODEL: the agent. JUDGE_MODEL: the eval judges (optional; defaults to GEMINI_MODEL).
GEMINI_MODEL=gemini-3.5-flash
JUDGE_MODEL=
# JUDGE_SAMPLES: judge votes per turn. Blank = 3 (test_config.json). Use 1 while developing.
JUDGE_SAMPLES=
# Supabase -> Connect -> Session pooler (the IPv4 one). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Your GitHub Pages address, no trailing slash (use * only while testing)
ALLOWED_ORIGINS=*
# Day 4 tracing (OpenTelemetry -> Cloud Trace). off by default.
TRACING=off
# Keep prompts and answers in spans (synthetic data here; think twice in production).
TRACE_CONTENT=true
# Day 5: BigQuery dataset for eval results (created by eval-adk/load_bigquery.py)
BQ_DATASET=overwatch_evals
BQ_LOCATION=US
